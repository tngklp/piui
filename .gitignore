# Dependencies
node_modules/

# Build output
out/
dist/
release/
release-linux/

# Caches
.vite/
.eslintcache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Scratch files (throwaway commit-message bodies, one-off build scripts).
.tmp-*
.tmp_*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.local

# Generated by scripts/make-icon.mjs, via `npm run assets` in predev/pretypecheck.
# The icon is drawn procedurally, so the script is the source, not the PNGs.
assets/icon.png
build/icon.png

# Changelog copy that electron-builder embeds in latest.yml, written by the
# release workflow so the in-app updater shows the notes we wrote rather than the
# GitHub feed's HTML.
build/release-notes.md

# Generated icon packs, copied out of material-icon-theme and
# @iconify-json/catppuccin by scripts/sync-*-icons.mjs (`npm run assets`).
src/renderer/public/material-icons/
src/renderer/src/lib/material-icons.json
src/renderer/public/catppuccin-icons/
src/renderer/src/lib/catppuccin-icons.json
